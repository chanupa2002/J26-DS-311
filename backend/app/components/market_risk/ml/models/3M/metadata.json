  "target_generation_method": "SUSTAIN-HH-Risk-Rule v1.0 (provisional, requires expert validation)",
  "target_rule": [
    {
      "Class": "High",
      "Condition": "T_Business_Not_Running = 1 OR count{T_No_Profit_Last_Month, T_Not_Progressing_Well, T_Market_Stress_Any = 1} >= 2"
    },
    {
      "Class": "Medium",
      "Condition": "Business running AND exactly one of the three signals = 1"
    },
    {
      "Class": "Low",
      "Condition": "Business running AND all three signals answered = 0"
    },
    {
      "Class": "Unassigned",
      "Condition": "Class differs between blanks=0 and blanks=1 (insufficient evidence); or business status blank"
    },
    {
      "Class": "-",
      "Condition": "Signals are counted, not netted: a positive signal is never cancelled by another; market tier does not override household answers"
    },
    {
      "Class": "-",
      "Condition": "Risk_Label_hM = class of same household's visit in calendar month t+h (h=3,6), exact match, no tolerance"
    }
  ],
